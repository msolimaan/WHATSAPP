# Copy to .env for local runs. On Railway/Fly.io set these as secrets instead.

PORT=3000
# Public https URL of this server, e.g. https://whatsapp-mcp.up.railway.app
PUBLIC_BASE_URL=
# Where the SQLite database lives. Mount a persistent volume here.
DATA_DIR=./data
# Your time zone for dates in reports
TIMEZONE=America/Sao_Paulo
# Access token for /mcp (temporary, until OAuth). Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# --- WhatsApp ---
# 360dialog (Coexistence partner) or meta (direct Cloud API)
WA_PROVIDER=360dialog
# 360dialog API key, or a Meta system-user access token
WA_API_KEY=
# Your business number, digits only with country code
WA_BUSINESS_NUMBER=
# Only needed for WA_PROVIDER=meta (and template management)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_GRAPH_VERSION=v23.0

# --- Trello CRM sync ---
# From https://trello.com/power-ups/admin (create a Power-Up, then generate an API key and token)
TRELLO_API_KEY=
TRELLO_TOKEN=
# Inhouse Creatives LEADS
TRELLO_BOARD_ID=6a5915aa978c66f85fe84d30
# Days without a reply before a Contacted lead moves to Follow Up
CRM_FOLLOW_UP_DAYS=3
# First preview: create cards for unknown numbers that wrote within this many days
CRM_NEW_LEAD_LOOKBACK_DAYS=30
CRM_CHANNEL_LABEL=WP

# --- Automatic follow-ups ---
# Local time window when sequences never send
FOLLOWUP_QUIET_HOURS=20:00-08:30
FOLLOWUP_SKIP_WEEKENDS=false
# Max paid template messages sequences may send per day
FOLLOWUP_DAILY_TEMPLATE_CAP=30

# --- Webhook security (set at least one) ---
# Meta app secret: deliveries must carry a valid X-Hub-Signature-256
WA_APP_SECRET=
# Random string (24+ chars). Webhook URL becomes https://<host>/webhook/<this>
# Generate: openssl rand -hex 24
WEBHOOK_PATH_SECRET=
# Token Meta sends when you register the webhook URL (Meta direct only)
WEBHOOK_VERIFY_TOKEN=
