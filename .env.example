# Copy to .env for local runs. On Railway/Fly.io set these as secrets instead.

PORT=3000
# Public https URL of this server, e.g. https://whatsapp-mcp.up.railway.app
PUBLIC_BASE_URL=
# Where the SQLite database lives. Mount a persistent volume here.
DATA_DIR=./data
# Your time zone for dates in reports
TIMEZONE=America/Sao_Paulo
# Access token for /mcp (temporary, until OAuth). Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# --- WhatsApp ---
# 360dialog (Coexistence partner) or meta (direct Cloud API)
WA_PROVIDER=360dialog
# 360dialog API key, or a Meta system-user access token
WA_API_KEY=
# Your business number, digits only with country code
WA_BUSINESS_NUMBER=
# Only needed for WA_PROVIDER=meta (and template management)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_GRAPH_VERSION=v23.0

# --- Webhook security (set at least one) ---
# Meta app secret: deliveries must carry a valid X-Hub-Signature-256
WA_APP_SECRET=
# Random string (24+ chars). Webhook URL becomes https://<host>/webhook/<this>
# Generate: openssl rand -hex 24
WEBHOOK_PATH_SECRET=
# Token Meta sends when you register the webhook URL (Meta direct only)
WEBHOOK_VERIFY_TOKEN=
